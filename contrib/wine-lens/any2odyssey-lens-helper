#!/bin/sh
# SPDX-License-Identifier: MIT
# any2odyssey-lens-helper, Wine flavour: the helper Any2Odyssey starts to switch the Odyssey 3D's lens.
# Makes sure Leia's Windows SR service and session are running in the Wine prefix that setup.sh prepared,
# then runs the Windows helper there. Contract (docs/LENS-SWITCH.md): prints "on" or "error: <reason>", and
# switches the lens off and exits when standard input closes.
# Try it by hand:  sleep 20 | any2odyssey-lens-helper
T=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
export WINEPREFIX=$T/prefix WINEDLLOVERRIDES="mscoree,mshtml="

"$T/tools/ensure-stack.sh" </dev/null || exit 1
WINEDEBUG=-all WINEPATH='C:\Program Files\LeiaSR\Platform\bin' exec wine "$T/build/any2odyssey-lens-helper.exe" 2>/dev/null
