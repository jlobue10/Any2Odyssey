# Maintainer: Jonathan LoBue <https://github.com/jlobue10>
#
# Builds the Linux edition of Any2Odyssey from the checkout this file is in:
#
#   cd packaging/arch && makepkg -si
#
# The Linux edition is the stereo viewer (images as red/cyan anaglyph or side
# by side) with, on an Odyssey 3D, glasses-free output for images and a live
# screen through the user's own copy of Leia's runtime under Wine, set up
# with /usr/share/any2odyssey/wine-lens/setup.sh. Samsung's conversion engine
# exists only on Windows; see docs/PLATFORMS.md.
pkgname=any2odyssey
pkgver=0.9.3
pkgrel=1
pkgdesc="Stereo viewer and Odyssey 3D output for images and a live screen (Linux edition of Any2Odyssey)"
arch=('x86_64' 'aarch64')
url="https://github.com/jlobue10/Any2Odyssey"
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'libglvnd' 'hicolor-icon-theme' 'libpipewire')
# clang: the PipeWire bindings are generated from its headers at build time.
makedepends=('cargo' 'clang')
optdepends=('onnxruntime-cpu: AI depth (2D to 3D) on the CPU'
            'onnxruntime-cuda: AI depth on an NVIDIA GPU'
            'curl: any2odyssey --install-depth-model'
            'zenity: Open and Save dialogs'
            'kdialog: Open and Save dialogs on KDE Plasma'
            'wayland: run in a Wayland session'
            'libx11: run in an X11 session'
            'libxkbcommon-x11: run in an X11 session'
            'libxcursor: pointer shapes in an X11 session'
            'libxi: input in an X11 session'
            'xdg-utils: View logs and Help links'
            'xdg-desktop-portal: live screen capture, with the portal backend of your desktop'
            'wine: the Odyssey 3D lens, eye tracker and weaver (any2odyssey-setup prepares them; also needs mingw-w64-gcc, clang, python, xorg-xrandr and rsync)')
# The release profile already strips debug information; there is nothing for a -debug package.
# No LTO flags from makepkg: they reach the C file the PipeWire bindings compile, as compiler-specific
# bytecode the Rust linker cannot read, and the link then fails over its functions. The Rust code is
# optimized across crates by the release profile itself.
options=('!debug' '!lto')
# The checkout is the source; nothing is downloaded. (namcap reports the $startdir
# references below; they are how an in-tree PKGBUILD finds its tree.)
source=()
sha256sums=()

_repo() {
  cd "$startdir/../.." && pwd
}

pkgver() {
  tr -d '[:space:]' < "$(_repo)/VERSION"
}

build() {
  cd "$(_repo)"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --locked --release -p any2odyssey
}

check() {
  cd "$(_repo)"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --locked --release -p any2odyssey-core -p any2odyssey
}

package() {
  local repo
  repo="$(_repo)"
  install -Dm755 "$srcdir/target/release/Any2Odyssey" "$pkgdir/usr/bin/any2odyssey"
  install -Dm644 "$repo/packaging/linux/any2odyssey.desktop" "$pkgdir/usr/share/applications/any2odyssey.desktop"
  install -Dm644 "$repo/assets/Any2Odyssey.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/any2odyssey.png"
  install -Dm644 "$repo/USER-GUIDE.html" "$pkgdir/usr/share/doc/any2odyssey/USER-GUIDE.html"
  install -Dm644 "$repo/README.md" "$pkgdir/usr/share/doc/any2odyssey/README.md"
  install -Dm644 "$repo/CHANGELOG.md" "$pkgdir/usr/share/doc/any2odyssey/CHANGELOG.md"
  # README.md links to every document in docs, to its screenshots, to installer/README.md and to the
  # license files; all of them are beside it under the paths it uses (the license files as links to
  # where Arch keeps them), and the check fails the package when a link leads nowhere.
  install -Dm644 -t "$pkgdir/usr/share/doc/any2odyssey/docs" "$repo"/docs/*.md
  install -Dm644 -t "$pkgdir/usr/share/doc/any2odyssey/docs/assets" "$repo"/docs/assets/*.png
  install -Dm644 "$repo/installer/README.md" "$pkgdir/usr/share/doc/any2odyssey/installer/README.md"
  install -Dm644 "$repo/assets/Any2Odyssey-wordmark.png" "$pkgdir/usr/share/doc/any2odyssey/assets/Any2Odyssey-wordmark.png"
  for file in LICENSE NOTICE THIRD-PARTY-LICENSES.md THIRD-PARTY-LICENSES-LINUX.md; do
    install -Dm644 "$repo/$file" "$pkgdir/usr/share/licenses/any2odyssey/$file"
    ln -s "../../licenses/any2odyssey/$file" "$pkgdir/usr/share/doc/any2odyssey/$file"
  done
  sh "$repo/scripts/check-doc-links.sh" "$pkgdir/usr/share/doc/any2odyssey"
  # The setup for the Odyssey 3D's lens, eye tracker and weaver under Wine (MIT). It is run by the user,
  # from here, and builds into their own data folder.
  install -d "$pkgdir/usr/share/any2odyssey"
  cp -R "$repo/contrib/wine-lens" "$pkgdir/usr/share/any2odyssey/wine-lens"
  # Its tests are for a checkout: nothing in the package runs them (0.9.1 shipped them).
  rm -rf "$pkgdir/usr/share/any2odyssey/wine-lens/tests"
  # Left in a checkout where contrib/wine-lens/tests/test-mkedid.py has run; no part of the package.
  find "$pkgdir/usr/share/any2odyssey/wine-lens" -name __pycache__ -type d -prune -exec rm -rf {} +
  chmod -R u=rwX,go=rX "$pkgdir/usr/share/any2odyssey/wine-lens"
  install -Dm644 "$repo/contrib/LICENSE-MIT" "$pkgdir/usr/share/licenses/any2odyssey/LICENSE-MIT"
  # The udev rules for the Odyssey 3D (lens board for the user at the seat, no USB power saving for its
  # webcam); pacman's udev hook reloads the rules.
  install -Dm644 "$repo/contrib/wine-lens/70-any2odyssey-lens.rules" "$pkgdir/usr/lib/udev/rules.d/70-any2odyssey-lens.rules"
  # any2odyssey-setup: the rest of what the Linux installer does (packages for the chosen features, the
  # depth model, the Wine side of the Odyssey 3D), for the user to run.
  install -Dm755 "$repo/packaging/linux/install.sh" "$pkgdir/usr/share/any2odyssey/install.sh"
  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /usr/share/any2odyssey/install.sh --packaged "$@"\n' > "$pkgdir/usr/bin/any2odyssey-setup"
  chmod 755 "$pkgdir/usr/bin/any2odyssey-setup"
}
